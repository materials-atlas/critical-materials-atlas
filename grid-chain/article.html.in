    :root{--acc:#795b2f}
    .study-nav{display:flex;flex-wrap:wrap;gap:.55rem 1.2rem;margin:1rem 0}
    .table-wrap{overflow-x:auto}
    .table-wrap table{margin:0}
    #static-trade[hidden]{display:none}
    details.panel summary{cursor:pointer;font-weight:700;color:var(--navy)}
    details.panel .table-wrap{margin-top:.8rem}
    figure.panel{margin-inline:0}
    figure.panel figcaption{margin-top:.8rem}
    .branches{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin:.7rem 0}
    .branches .hop{min-height:0}
    .network-join{margin:.45rem 0;padding:.55rem .7rem;background:var(--bg-soft);border-left:3px solid var(--acc)}
    .pairs{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
    .pair b{font-size:.85rem;color:var(--navy)}
    .paired-value{display:grid;grid-template-columns:3.4rem minmax(1rem,1fr) 3.2rem;gap:.35rem;align-items:center;font-size:.77rem}
    .paired-value strong{text-align:right;font-variant-numeric:tabular-nums}
    .paired-value .track{height:8px}
    .paired-value .imported{background:#685780}
    .forest-line{margin:.8rem 0}
    .forest-line p{margin:.2rem 0}
    .forest-track{position:relative;height:1.8rem;background:var(--bg-soft);border-radius:6px}
    .forest-track .zero{position:absolute;inset-block:0;width:2px;background:var(--mut)}
    .forest-track .interval{position:absolute;top:50%;height:3px;background:var(--acc)}
    .forest-track .point{position:absolute;top:calc(50% - 4px);width:10px;height:10px;border-radius:50%;background:var(--acc);transform:translateX(-50%)}
    @media(max-width:550px){.branches,.pairs{grid-template-columns:1fr}}
  </style>
