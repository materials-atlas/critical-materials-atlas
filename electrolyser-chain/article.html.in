<link rel="stylesheet" href="../assets/site.css"><link rel="stylesheet" href="../chain-assets/chainview.css"><style>
  :root { --acc: #3f7d8a; }
  .table-wrap { overflow-x: auto; margin: 1rem 0; }
  .table-wrap table { min-width: 32rem; margin: 0; }
  caption, figcaption { padding: .4rem .5rem; text-align: left; color: var(--mut); font-size: .83rem; }
  th[scope="row"] { font-weight: 600; }
  .numbers td { white-space: nowrap; font-variant-numeric: tabular-nums; }
  #static-trade[hidden], #frontier-controls[hidden] { display: none; }
  #frontier-controls { display: grid; grid-template-columns: repeat(auto-fit,minmax(12rem,1fr)); gap: .8rem; }
  #frontier-controls label { display: grid; gap: .35rem; }
  #frontier-results { display: flex; flex-wrap: wrap; gap: .55rem 1rem; margin: .85rem 0 0; }
  #frontier-results span { display: block; }
  .annual-charts { display: grid; grid-template-columns: repeat(auto-fit,minmax(11rem,1fr)); gap: .9rem; }
  .series { position: relative; height: 7rem; display: flex; gap: 1px; align-items: end; border-bottom: 1px solid #627575; background: #eff5f4; }
  .series::after { content: ""; position: absolute; inset-inline: 0; bottom: var(--supply); border-top: 2px dashed #202e31; }
  .series i { flex: 1; background: #3f7d8a; }
  .time-axis { display: flex; justify-content: space-between; font-size: .8rem; }
  .followup-chart { margin: 1rem 0; }
  .sensitivity-track { display: block; position: relative; min-width: 5rem; height: .65rem; margin-top: .2rem; border-block-end: 1px solid #bac5cc; }
  .sensitivity-interval { position: absolute; inset-block-start: .25rem; height: .25rem; background: #687983; }
  .sensitivity-reference { position: absolute; height: .65rem; border-inline-start: 1px solid currentColor; }
