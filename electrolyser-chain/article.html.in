<footer class="siteftr"><div class="wrap"><div><h4>Critical Materials Atlas</h4>Public-data research on manufacturing and materials.</div><div><h4>Related research</h4><a href="../value-chains">All value chains</a><br><a href="../pgm-catalyst-chain/pgm-catalyst-chain">Platinum-group metals</a></div><div><h4>Evidence</h4><a href="out/electrolyser_chain.json">Evidence JSON</a><br><a href="PRODUCTION.md">Claim register</a></div><div class="fineprint">Found an error, or want to challenge a figure? Write to <a href="mailto:contact@criticalmaterialsatlas.org">contact@criticalmaterialsatlas.org</a>.</div></div></footer>
<script>window.CHAIN_TRADE='out/electrolyser_trade.json';</script>
<script src="../chain-assets/chainview.js"></script>
<script>
(function () {
  const controls = document.getElementById("frontier-controls");
  const gw = document.getElementById("pem-additions");
  const loading = document.getElementById("ir-loading");
  const share = document.getElementById("ir-share");
  const supply = Number(document.getElementById("frontier").dataset.primary);
  const formatter = new Intl.NumberFormat("en", {maximumFractionDigits: 2});
  function set(id, value, unit) {
    document.getElementById(id).textContent = formatter.format(value) + " " + unit;
  }
  controls.addEventListener("input", function () {
    const gross = Number(gw.value) * Number(loading.value);
    const available = supply * Number(share.value);
    set("pem-gw", Number(gw.value), "GW/year");
    set("ir-gross", gross, "t/year");
    set("ir-available", available, "t/year");
    set("ir-gap", Math.max(0, gross - available), "t/year");
    set("ir-threshold", available / Number(loading.value), "GW/year");
  });
  controls.hidden = false;
}());
</script>
</body></html>
