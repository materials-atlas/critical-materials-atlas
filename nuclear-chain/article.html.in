<section class="hero"><div class="wrap">
  <div class="eyebrow">Nuclear fuel supply</div>
  <h1>${title}</h1>
  <p class="deck">${deck}</p>
  <p class="byline">Evidence release · <time datetime="${version}">24 November 2026</time></p>
</div></section>
<article>
<nav class="study-nav" aria-label="On this page">
  <a href="#stages">Fuel-cycle stages</a>
  <a href="#exposure">EU and US exposure</a>
