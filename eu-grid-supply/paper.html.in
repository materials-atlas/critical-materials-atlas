<main id="main">
<section class="hero"><div class="wrap">
  <div class="eyebrow">Electricity grid · Research working paper</div>
  <h1>${title}</h1>
  <p class="deck">${deck}</p>
  <p class="byline">Working paper · <time datetime="${version}">25 November 2026</time> · Presents a study filed on 21 September 2026</p>
</div></section>
<article>
<nav class="study-nav" aria-label="On this page">
  <a href="#measure">The measure</a>
  <a href="#results">Results for 2024</a>
  <a href="#context">Earlier years</a>
  <a href="#codes">Product definitions</a>
